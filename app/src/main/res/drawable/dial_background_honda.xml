<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="400dp"
    android:height="400dp"
    android:viewportWidth="400"
    android:viewportHeight="400">
    <!-- Honda dial with red warning zone but NO tick marks (speedviewlib renders ticks) -->
    <!-- Outer ring -->
    <path
        android:pathData="M200,200 m-185,0 a185,185 0 1,1 370,0 a185,185 0 1,1 -370,0"
        android:strokeColor="#2A2A3E"
        android:strokeWidth="1.5"
        android:fillColor="#00000000" />
    <!-- Inner ring -->
    <path
        android:pathData="M200,200 m-160,0 a160,160 0 1,1 320,0 a160,160 0 1,1 -320,0"
        android:strokeColor="#1E1E30"
        android:strokeWidth="1"
        android:fillColor="#00000000" />
    <!-- Red warning zone arc (top-right quadrant, subtle) -->
    <path
        android:pathData="M200,200 m-140,0 a140,140 0 0,1 121.24,-70 L200,200 Z"
        android:fillColor="#22E40521" />
</vector>
